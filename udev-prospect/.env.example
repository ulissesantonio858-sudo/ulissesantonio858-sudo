# UDEV Prospect — configuração. Copie para ".env" e preencha. NUNCA partilhe nem faça commit do .env.
# Linhas com "=" vazio são opcionais, salvo indicação em contrário.

# ------------------------------------------------------------------
# 1. Acesso à aplicação (OBRIGATÓRIO no modo local / Docker)
# ------------------------------------------------------------------
AUTH_MODE=local
# Email e palavra-passe com que vai entrar em http://localhost:3000 (palavra-passe com pelo menos 10 caracteres)
APP_LOGIN_EMAIL=
APP_PASSWORD=
# Mostrar o botão "Ver demonstração" no login (dados fictícios, separados dos reais): true/false
DEMO_ENABLED=true
# Opcional: segredo de sessão (≥ 32 caracteres). Se vazio, é gerado automaticamente e guardado na base de dados.
SESSION_SECRET=
# Só "true" se servir a app por HTTPS
COOKIE_SECURE=false

# ------------------------------------------------------------------
# 2. Base de dados
# ------------------------------------------------------------------
# Docker: a palavra-passe do Postgres interno (a base de dados não é exposta fora do Docker).
POSTGRES_PASSWORD=udev-local
# Sem Docker (npm run dev): string de ligação a um Postgres. No Docker é definida automaticamente.
DATABASE_URL=
DB_POOL_MAX=5
# Porta local da interface
APP_PORT=3000

# ------------------------------------------------------------------
# 3. Fontes de dados (pelo menos UMA fonte de descoberta tem de responder)
# ------------------------------------------------------------------
# Google Places API (New) — recomendado. Ver INTEGRACOES.md
GOOGLE_PLACES_API_KEY=
# Pedir datas de avaliações (sinal de atividade). Pode subir o escalão de faturação do pedido.
PLACES_INCLUDE_REVIEWS=false
# OpenStreetMap / Overpass — sem chave; cobertura irregular em Vila Real. "false" desliga.
OSM_ENABLED=true
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Brave Search API — necessária para concluir "site não localizado". Ver INTEGRACOES.md
BRAVE_SEARCH_API_KEY=

# ------------------------------------------------------------------
# 4. IA (opcional) — sugestão de nicho com evidência citada
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ------------------------------------------------------------------
# 5. Alternativa: alojamento com Supabase (AUTH_MODE=supabase). Não necessário no Docker local.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ALLOWED_EMAILS=
