# UDEV Prospect — variáveis de ambiente (copiar para .env.local; NUNCA commitar valores reais)

# --- Base de dados (obrigatório) ---
# String de ligação Postgres do Supabase (Project Settings → Database). Usada só no servidor e no worker.
DATABASE_URL=
DB_POOL_MAX=5

# --- Autenticação Supabase (obrigatório em produção) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Lista de emails autorizados (separados por vírgula). Vazio = qualquer utilizador existente no projeto Supabase.
ALLOWED_EMAILS=

# --- Desenvolvimento local sem Supabase (ignorado quando NODE_ENV=production) ---
# UUID fixo do utilizador local, usado com Postgres local + scripts/local-auth-shim.sql
DEV_AUTH_USER_ID=

# --- Descoberta de empresas ---
# Google Places API (New): ativar "Places API (New)" no Google Cloud e restringir a chave por API/IP.
GOOGLE_PLACES_API_KEY=
# Pedir também datas de avaliações (sinal de atividade). Aumenta o escalão de custo do pedido.
PLACES_INCLUDE_REVIEWS=false
# OpenStreetMap / Overpass (sem chave). "false" para desligar.
OSM_ENABLED=true
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Pesquisa web (site pelo nome + localidade) ---
BRAVE_SEARCH_API_KEY=

# --- IA (opcional: sugestão de nicho com evidência citada) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
