  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "DATABASE_URL_TEST=${DATABASE_URL_TEST:-postgres://postgres:postgres@localhost:5432/udev_test} vitest run",
