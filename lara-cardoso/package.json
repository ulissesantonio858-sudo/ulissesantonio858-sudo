    "images": "node scripts/optimize-images.mjs",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource/lora": "^5.1.0",
    "@fontsource/manrope": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
